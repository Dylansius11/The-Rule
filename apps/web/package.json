{
  "name": "@the-rule/web",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.22.2" },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write src e2e",
    "format:check": "prettier --check src e2e",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/nunito": "5.3.0",
    "@fontsource/delicious-handrawn": "5.3.0",
    "@fontsource/londrina-solid": "5.3.0",
    "@hot-labs/near-connect": "0.12.0",
    "@tanstack/react-query": "5.105.3",
    "@tanstack/react-virtual": "3.14.26",
    "@the-rule/verifier-wasm": "workspace:*",
    "motion": "14.9.1",
    "near-api-js": "7.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
